# Which AI to use: gemini or openrouter
AI_PROVIDER=gemini

# Gemini (free key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite

# OpenRouter (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free

# Supabase - stores every conversation so a refresh (or reopening a listing)
# resumes the same chat, and powers the /leads dashboard.
# Project Settings -> API in your Supabase dashboard.
# IMPORTANT: use the service_role key (server-only), never the anon key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key-here

# WhatsApp Cloud API (Meta app -> WhatsApp -> API Setup). Leave DRY_RUN=true to
# test with the "WhatsApp test" tab without sending anything to Meta.
WHATSAPP_DRY_RUN=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=pick-any-long-random-text
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# Team password for the web pages (required once the server is online)
ADMIN_USERNAME=team
ADMIN_PASSWORD=

# Maintenance photo classifier ("Report an issue" page, /maintenance).
# Always uses OpenRouter's free vision models directly, regardless of
# AI_PROVIDER above - reuses OPENROUTER_API_KEY, so set that even if
# AI_PROVIDER=gemini. Run supabase_maintenance_tickets.sql to save
# reports and enable the Maintenance dashboard tab.
MAINTENANCE_MODELS=openrouter/free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,dots-studio/dots-3-note-preview:free
MAINTENANCE_MAX_IMAGE_MB=10

# Resident onboarding (supabase_lease_onboarding.sql)
# Public address of this server, used in the private tenant/owner links sent on WhatsApp.
PUBLIC_BASE_URL=https://your-staybot-server.example.com
# Private Supabase Storage bucket for documents and lease PDFs (created automatically, must stay private)
ONBOARDING_BUCKET=onboarding-private

# Owner listings added through the chat (supabase_owner_listings.sql, supabase_owner_listing_photos.sql)
# Public Supabase Storage bucket for photos owners attach to their listing draft (created automatically, safe to be public)
PROPERTY_PHOTOS_BUCKET=property-photos
# Forgot password / email password reset (supabase_password_reset.sql, src/services/password_reset.py).
# The emailed link is built from APP_BASE_URL, or PUBLIC_BASE_URL above if that is blank - set one of them
# to this server's public address (it is never taken from the request). Email is sent with the EMAIL_SMTP_* settings.
APP_BASE_URL=
PASSWORD_RESET_TTL_MINUTES=60
# true = a successful reset also signs the account out of every device (default false: sessions are left alone)
PASSWORD_RESET_REVOKE_SESSIONS=false
# Approved WhatsApp templates (needed to message people who haven't written to you in the last 24 hours)
WHATSAPP_TEMPLATE_INVITE=
WHATSAPP_TEMPLATE_LEASE_READY=
WHATSAPP_TEMPLATE_LANGUAGE=en_US
# Approved template used only when a deadline reminder free-form send is rejected by Meta with error 131047 (24-hour window closed).
# The template should have three body variables: offer reference, deadline label, due date.
WHATSAPP_DEADLINE_REMINDER_TEMPLATE=
WHATSAPP_DEADLINE_REMINDER_TEMPLATE_LANGUAGE=en_US
# While testing with live WhatsApp, only these numbers receive messages from test/demo cases
WHATSAPP_TEST_RECIPIENTS=
# TurboTenant: not integrated (no public API docs). Setting these alone does not connect anything.
TURBOTENANT_API_BASE=
TURBOTENANT_API_KEY=

# Purchase-offer / inspection workflow
PURCHASE_DEADLINE_WORKER=true
# Contract platform is deliberately unset until the broker confirms zipForm, Dotloop, or SkySlope.
BROKER_CONTRACT_PLATFORM=unselected

# HubSpot CRM sync (src/services/hubspot.py). Settings -> Integrations -> Private
# Apps -> create one with crm.objects.contacts.read/write,
# crm.objects.custom.read/write, crm.schemas.custom.read, crm.associations.read/write.
# Mirrors every WhatsApp chat turn into Contacts + the "Inquiry"/"Property" custom
# objects on this portal. Leave blank to disable (no-op, chat still works).
HUBSPOT_ACCESS_TOKEN=

# Market the AI talks about, and the currency it must never convert (USD or INR)
BUSINESS_MARKET=North Carolina (Raleigh, Garner, Fuquay-Varina, Cary, Durham, Charlotte, Greensboro, Wilmington)
BUSINESS_CURRENCY=USD
# Viewing times ("Saturday at 10am") are read in this timezone.
APP_TIMEZONE=America/New_York

# Hot customer alert: when a chat turns Hot (or the score goes over 90) the
# staff member is told by email and/or WhatsApp - name, phone, what they want,
# score and a link to Inquiries -> All chats. Comma-separate several people.
# The customer is never sent this. Blank = the alert is only printed in the log.
STAFF_ALERT_EMAIL=
STAFF_ALERT_WHATSAPP=
# WhatsApp only lets the business message someone first with an approved
# template (body with 4 values: name, phone, wants, score). Without it a plain
# text is sent, which only arrives if the staff member messaged the business
# number in the last 24 hours.
WHATSAPP_TEMPLATE_HOT_LEAD=
WHATSAPP_TEMPLATE_HOT_LEAD_LANGUAGE=en_US

# Homes listed by New / Existing Property Investor accounts (in the chat or
# their "My listings" tab) go live for tenants immediately. Set to true to
# send them through the team's "New listings" review queue first instead.
INVESTOR_LISTINGS_NEED_REVIEW=false

# Privacy policy page (/privacy) - Meta needs this link for WhatsApp.
# Put the client's real details here before giving Meta the link.
BUSINESS_NAME=Staybot Realty
PRIVACY_EMAIL=privacy@example.com
BUSINESS_POSTAL_ADDRESS=Garner, NC
PRIVACY_UPDATED=October 3, 2026
